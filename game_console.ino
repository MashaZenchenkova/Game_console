void start()
{
  display.clearDisplay();
  display.drawBitmap(0, 0, myBitmap, 128, 64, SSD1306_WHITE);
  display.display();
  while (true) 
  {
    if (analogRead(JOY_X) < 1000) 
    {
      t = 1; 
      delay(300);
      break;     
    }
    else if (analogRead(JOY_X) > 4000) 
    {
      t = 0; 
      delay(300);
      break;     
    }
    delay(50); 
  }
}
