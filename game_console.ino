bool win() 
{
  bool zbc = false;
  bool gavno = true;
  while (gavno) 
  {
    gavno = false; 
    for (int i = 126; i >= 1; i--) 
    {
      bool is_full = true;
      for (int j = 1; j <= 62; j++) 
      {
        if (game[j][i] == 0) 
        {
          is_full = false;
          break;
        }
      }
      if (is_full) 
      {
        for (int st_i = i; st_i > 1; st_i--) 
        {
          for (int j = 1; j <= 62; j++) {
            game[j][st_i] = game[j][st_i - 1];
          }
        }
        for (int j = 1; j <= 62; j++) 
        {
          game[j][1] = 0;
        }
        zbc = true;
        gavno = true; 
        break; 
      }
    }
  }
  return zbc;
}
